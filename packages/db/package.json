{
  "name": "@pm/db",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:link": "supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "db:push": "supabase db push",
    "db:push:url": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:generate-types": "supabase gen types typescript --local > src/database.types.ts",
    "db:generate-types:remote": "supabase gen types typescript --linked > src/database.types.ts"
  },
  "dependencies": {
    "@pm/types": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pm/tsconfig": "workspace:*",
    "supabase": "^1.224.1",
    "typescript": "^5.7.2"
  }
}
